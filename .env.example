# Groq API Configuration (Optional - Pipeline has local deterministic fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Docs Integration (Phase 9)
# Provide the Document ID of an existing Google Doc (found in https://docs.google.com/document/d/<DOC_ID>/edit)
GDOCS_DOC_ID=1IsqpOHq53G51Shg5R271iq7P57k6wUqqQKVNzJVA6dw

# Gmail Draft Integration (Phase 10)
# Provide the email address where the weekly pulse draft should be addressed
EMAIL_RECIPIENT=support-team@groww.in

# MCP Server Configuration
# Defaults to the local MCP server running on port 8000
MCP_SERVER_URL=http://localhost:8000

# Web Dashboard / API Server Port
PORT=8000

# Frontend API URL
REACT_APP_API_URL=http://localhost:8000
